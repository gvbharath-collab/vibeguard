# Copy to .env and adjust. No secrets are required.
PORT=8787
AUDIT_TIMEOUT_MS=8000        # per-request timeout
AUDIT_TOTAL_TIMEOUT_MS=45000 # whole-audit cap
AUDIT_MAX_BYTES=1048576      # max response body read per request
AUDIT_MAX_REDIRECTS=5
RATE_LIMIT_PER_MIN=5         # audits per client IP per minute
MAX_CONCURRENT_AUDITS=5
CORS_ORIGIN=                 # comma-separated allowed frontend origins, only if the frontend is served from another origin
SERVE_FRONTEND=true
TRUST_PROXY=false            # true only behind a proxy you control (uses X-Forwarded-For)
# DEV ONLY: lets you audit your own localhost app. Keep false in production.
ALLOW_PRIVATE_TARGETS=false
